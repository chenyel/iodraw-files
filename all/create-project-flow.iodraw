        <mxCell id="note2" value="💡 未配置知识条目时，项目默认可使用当前空间全部已发布知识" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=11;size=16;" parent="laneU" vertex="1">
