        <mxCell id="f1f2" value="projectService.page()&lt;br&gt;GET /api/data-studio/projects&lt;br&gt;?workspaceId&amp;keyword&amp;pageNum&amp;pageSize&lt;br&gt;· 搜索 300ms 防抖&lt;br&gt;· keyword/pageNum 同步 URL 可恢复&lt;br&gt;· requestIdRef 序号防翻页竞态" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="480" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f2f1" value="NewProjectModal 打开即拉预置分类&lt;br&gt;GET /workspaces/{sid}/knowledge-categories/tree&lt;br&gt;前端只留 isPreset 一级分类逐行渲染&lt;br&gt;条目弹窗：GET /km/spaces/{sid}/entries?categoryId=" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="730" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f2f2" value="mergeInstructions()：指令合并进&lt;br&gt;defaultParams JSON 的 instructions key&lt;br&gt;（通用参数容器，不覆盖其余参数）&lt;br&gt;→ POST /api/data-studio/projects&lt;br&gt;body {workspaceId, name, defaultParams}" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="880" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2f3" value="收到 ProjectDTO(含雪花 bizId)&lt;br&gt;Promise.allSettled 并发逐个绑定&lt;br&gt;POST /projects/{bizId}/assets {assetId}&lt;br&gt;【创建与绑定是两个独立请求】" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1020" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2f4" value="navigate(&#39;/dw/projects/&#39;+bizId)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1160" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2e1" value="err: 403/400 → toast 错误提示&lt;br&gt;用户修改后重试" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#F8CECC;strokeColor=#B85450;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1260" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f3f1" value="路由匹配 /dw/projects/:id&lt;br&gt;→ ProjectDetailPage 挂载&lt;br&gt;Tab 状态同步 URL ?tab=" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1470" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3f2" value="Promise.all 并行加载：&lt;br&gt;① GET /projects/{id}?workspaceId&lt;br&gt;② GET /workbench/projects/{id}/sidebar&lt;br&gt;　?scope=all（requestId 防竞态）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1600" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f4f1" value="ProjectEditModal 三 Tab：&lt;br&gt;· 基础信息：名称/描述/Agent 只读&lt;br&gt;· 技能：知识库绑定（即时生效，不走保存）&lt;br&gt;· 高级设置：指令 + 运行参数 JSON" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1840" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f4f2" value="useProjectSettingsSave 统一保存：&lt;br&gt;校验 名称非空 / JSON 合法&lt;br&gt;PUT /projects/{id}?workspaceId&lt;br&gt;body 含 version（乐观锁）&lt;br&gt;重命名走 ProjectActions 同一 PUT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1990" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f4f3" value="onSaved(updated)：关弹窗 + 刷新&lt;br&gt;409：toast + GET 重拉详情&lt;br&gt;回填表单，用户确认后重试" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2200" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5f1" value="ProjectAssetsSection（两处共用）：&lt;br&gt;listByProject 拿绑定 refs，再逐个&lt;br&gt;entryService.get 组装按分类分组展示" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2430" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5f2" value="添加：AddAssetModal 拉全部分类&lt;br&gt;+ 各分类已发布条目(status=published)&lt;br&gt;allSettled 并发 POST /{id}/assets&lt;br&gt;移除：DELETE /{id}/assets/{assetId}" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2560" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f6f1" value="GET /projects/{id}/comments&lt;br&gt;?workspaceId&amp;pageNum&amp;pageSize&lt;br&gt;按时间倒序，20 条/页&lt;br&gt;加载更多 + AbortController 防竞态" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2880" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f6f2" value="POST /projects/{id}/comments {content}&lt;br&gt;发布成功后重置回第 1 页重拉&lt;br&gt;（倒序分页发布会导致 offset 漂移）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3020" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f7f1" value="GET / POST / PUT / DELETE&lt;br&gt;/projects/{id}/plan-items[/{itemId}]&lt;br&gt;?workspaceId（仅要求空间成员）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3250" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f8f1" value="会话列表来自流程 3 的 sidebar.sessions&lt;br&gt;运行中判定：bench 且 latestRunStatus&lt;br&gt;为 pending/running（与后端调度一致）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3520" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f8f2" value="删除会话（仅 session.creatorMis&lt;br&gt;=== 当前用户可见删除按钮）：&lt;br&gt;benchService / studioService&lt;br&gt;.deleteSession（软删进回收站）&lt;br&gt;可选 .purgeSession（彻底删除）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3660" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f9f1" value="projectService.delete()&lt;br&gt;DELETE /projects/{id}?workspaceId" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3910" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f10f1" value="DELETE /projects/{id}/purge?workspaceId" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="4240" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pre" value="【统一口径 · 全部流程共用】&lt;br&gt;① 路由：BrowserRouter basename=/aids&lt;br&gt;　 /dw/projects 列表 · /dw/projects/:id 详情 · /dw/task/:taskId 任务&lt;br&gt;② 空间上下文：SpaceProvider.currentSpace.id&lt;br&gt;　 = 所有请求的 workspaceId（DW 挂在 KM 空间之下）&lt;br&gt;③ 后端鉴权：UserUtils 取当前 MIS →&lt;br&gt;　 kmSpaceService.getMemberRoles() 空间成员校验&lt;br&gt;　 读接口非成员一律 404（不暴露存在性）；创建是 403&lt;br&gt;④ 权限分级：子资源(留言/计划/资产/会话)读写仅要求成员；&lt;br&gt;　 项目级 更新/删除/硬删 要求 创建者 或 空间 admin&lt;br&gt;⑤ ID：mdpLeafClient 雪花 bizId（全局唯一）&lt;br&gt;⑥ 全表 workspaceId + isDeleted 软删标记&lt;br&gt;⑦ axios 拦截器：success=false 透出 message；&lt;br&gt;　 401/302 跳 /sso/login（带回跳）" style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=11;size=16;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="30" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f9n1" value="⚠ 口径说明：Controller 注释写「存在&lt;br&gt;未删除 Agent 时拒绝」，但实现是级联&lt;br&gt;软删（agentsDeleted）。以代码为准，&lt;br&gt;注释已过时。" style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=11;size=16;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="4010" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="后端 Spring（data-agent-dw）" style="swimlane;startSize=30;horizontal=0;html=1;fillColor=#D5E8D4;" parent="pool1" vertex="1">
          <mxGeometry x="820" width="400" height="4920" as="geometry" />
        </mxCell>
        <mxCell id="f1b1" value="ProjectController.listProjects&lt;br&gt;UserUtils 取 MIS → getMemberRoles()&lt;br&gt;空间成员校验，非成员返回 404" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="360" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2b1" value="ProjectController.createProject&lt;br&gt;UserUtils 取 MIS → 成员校验&lt;br&gt;非成员 403；创建仅要求空间成员&lt;br&gt;（更新/删除才要求创建者或 admin）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="730" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2b2" value="ProjectService.createProject&lt;br&gt;@Transactional 两写一事务：&lt;br&gt;① 雪花 bizId ② INSERT 项目&lt;br&gt;③ bot 欢迎留言（失败整体回滚）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="860" width="320" height="90" as="geometry" />
        </mxCell>
