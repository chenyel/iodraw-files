    <mxGraphModel dx="1573" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="3400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="「我的项目」→ 创建项目 · 全流程（用户视角 × 前后端架构）" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" width="1620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pool1" value="创建项目全流程" style="swimlane;childLayout=stackLayout;horizontal=0;startSize=20;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;align=center;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="1620" height="3320" as="geometry" />
        </mxCell>
        <mxCell id="laneU" value="用户（操作与所见）" style="swimlane;startSize=30;horizontal=0;html=1;fillColor=#FFE6CC;align=center;fontSize=15;" parent="pool1" vertex="1">
          <mxGeometry x="20" width="400" height="3320" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="【开始】从导航进入「项目」&lt;br style=&quot;font-size: 15px;&quot;&gt;打开我的项目列表页&lt;br style=&quot;font-size: 15px;&quot;&gt;浏览器地址：/aids/dw/projects" style="ellipse;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="60" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="浏览项目卡片 / 搜索 / 翻页&lt;br style=&quot;font-size: 15px;&quot;&gt;点击右上角「+ 新建项目」&lt;br style=&quot;font-size: 15px;&quot;&gt;（空列表态也有同样入口）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="560" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="填写项目名称 *（必填，≤15 字）&lt;br style=&quot;font-size: 15px;&quot;&gt;输入「指令」—— 本项目的长期 System Prompt&lt;br style=&quot;font-size: 15px;&quot;&gt;决定 AI 在此项目中的工作方式与回复风格" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="1000" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="点某分类行的「+ 添加」&lt;br style=&quot;font-size: 15px;&quot;&gt;弹出二级条目选择弹窗&lt;br style=&quot;font-size: 15px;&quot;&gt;checkbox 多选，可跨分类累计" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="1140" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="💡 绑定即白名单：未配置知识条目时，&lt;br style=&quot;font-size: 15px;&quot;&gt;项目默认可使用当前空间&lt;b style=&quot;font-size: 15px;&quot;&gt;全部已发布知识&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;—— 这是资产绑定的架构前提" style="shape=note;whiteSpace=wrap;html=1;align=center;spacing=6;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=15;size=16;" parent="laneU" vertex="1">
          <mxGeometry x="60" y="1260" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="点击「确定」提交" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="1440" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="u6" value="【结束】进入项目详情页&lt;br style=&quot;font-size: 15px;&quot;&gt;资产 tab 展示刚绑定的条目&lt;br style=&quot;font-size: 15px;&quot;&gt;留言区出现 bot 欢迎语 —— 闭环完成" style="ellipse;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" parent="laneU" vertex="1">
          <mxGeometry x="50" y="3100" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="laneF" value="前端 React（浏览器内）" style="swimlane;startSize=30;horizontal=0;html=1;fillColor=#DAE8FC;align=center;fontSize=15;" parent="pool1" vertex="1">
          <mxGeometry x="420" width="400" height="3320" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="💡 axios 响应拦截器（全局兜底）&lt;br style=&quot;font-size: 15px;&quot;&gt;success=false → 透出后端 message&lt;br style=&quot;font-size: 15px;&quot;&gt;401/302 → 跳 /sso/login（带回跳地址）" style="shape=note;whiteSpace=wrap;html=1;align=center;spacing=6;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=15;size=16;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="40" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="React Router 路由匹配&lt;br style=&quot;font-size: 15px;&quot;&gt;BrowserRouter basename=&quot;/aids&quot;&lt;br style=&quot;font-size: 15px;&quot;&gt;/dw/projects → ProjectListPage&lt;br style=&quot;font-size: 15px;&quot;&gt;（App.tsx，挂载于 AppLayout 布局下）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="170" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f0" value="SpaceProvider 空间上下文（全局）&lt;br style=&quot;font-size: 15px;&quot;&gt;currentSpace.id 作为后续所有请求的 workspaceId&lt;br style=&quot;font-size: 15px;&quot;&gt;【架构】DW 项目域挂在 KM 空间之下" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="300" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="projectService.page() 分页加载列表&lt;br style=&quot;font-size: 15px;&quot;&gt;GET /api/data-studio/projects&lt;br style=&quot;font-size: 15px;&quot;&gt;?workspaceId&amp;amp;keyword&amp;amp;pageNum&lt;br style=&quot;font-size: 15px;&quot;&gt;· 搜索 300ms 防抖&lt;br style=&quot;font-size: 15px;&quot;&gt;· keyword/pageNum 同步 URL，刷新可恢复&lt;br style=&quot;font-size: 15px;&quot;&gt;· requestIdRef 序号防翻页竞态" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="430" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="createOpen=true → 条件渲染 NewProjectModal&lt;br style=&quot;font-size: 15px;&quot;&gt;useEffect 同时拉取预置分类" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="700" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="categoryService.tree(spaceId)&lt;br style=&quot;font-size: 15px;&quot;&gt;GET /workspaces/{spaceId}/knowledge-categories/tree&lt;br style=&quot;font-size: 15px;&quot;&gt;前端过滤：只留 isPreset 的&lt;b style=&quot;font-size: 15px;&quot;&gt;一级预置分类&lt;/b&gt;，逐行渲染" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="830" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="entryService.page(spaceId, {categoryId})&lt;br style=&quot;font-size: 15px;&quot;&gt;GET /km/spaces/{spaceId}/entries?categoryId=&lt;br style=&quot;font-size: 15px;&quot;&gt;已选条目从候选列表中过滤去重" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1260" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="前端校验：名称非空、spaceId 存在&lt;br style=&quot;font-size: 15px;&quot;&gt;mergeInstructions()：指令&lt;b style=&quot;font-size: 15px;&quot;&gt;合并&lt;/b&gt;进 defaultParams&lt;br style=&quot;font-size: 15px;&quot;&gt;JSON 的 instructions key（不覆盖其余参数）&lt;br style=&quot;font-size: 15px;&quot;&gt;【架构】defaultParams 是通用参数容器，&lt;br style=&quot;font-size: 15px;&quot;&gt;指令只是其中一个约定 key，可继续扩展" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1560" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="projectService.create()&lt;br style=&quot;font-size: 15px;&quot;&gt;POST /api/data-studio/projects&lt;br style=&quot;font-size: 15px;&quot;&gt;body: {workspaceId, name, defaultParams}" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1730" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="err1" value="toast 错误提示（catch 分支）&lt;br style=&quot;font-size: 15px;&quot;&gt;403 非空间成员 / 400 参数错误&lt;br style=&quot;font-size: 15px;&quot;&gt;用户修改后可重试" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="1860" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="拿到 ProjectDTO（含雪花 bizId）&lt;br style=&quot;font-size: 15px;&quot;&gt;Promise.allSettled &lt;b style=&quot;font-size: 15px;&quot;&gt;并发&lt;/b&gt;逐个绑定已选条目&lt;br style=&quot;font-size: 15px;&quot;&gt;POST /api/data-studio/projects/{bizId}/assets&lt;br style=&quot;font-size: 15px;&quot;&gt;body: {assetId}&lt;br style=&quot;font-size: 15px;&quot;&gt;【架构】创建与绑定是两个独立请求，&lt;br style=&quot;font-size: 15px;&quot;&gt;绑定失败不回滚已创建的项目" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2520" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="err2" value="部分绑定失败 → toast&lt;br style=&quot;font-size: 15px;&quot;&gt;「绑定成功 X 个、失败 Y 个」&lt;br style=&quot;font-size: 15px;&quot;&gt;项目已创建，不回滚（可用性优先，可补偿）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="2860" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="navigate(&#39;/dw/projects/&#39; + bizId)&lt;br style=&quot;font-size: 15px;&quot;&gt;路由匹配 /dw/projects/:id" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3000" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="ProjectDetailPage 挂载&lt;br style=&quot;font-size: 15px;&quot;&gt;Promise.all &lt;b style=&quot;font-size: 15px;&quot;&gt;并行&lt;/b&gt;加载：&lt;br style=&quot;font-size: 15px;&quot;&gt;项目详情 + projectSidebar 聚合&lt;br style=&quot;font-size: 15px;&quot;&gt;（同样 requestId 防竞态）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="3110" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="后端 Spring（data-agent-dw）" style="swimlane;startSize=30;horizontal=0;html=1;fillColor=#D5E8D4;align=center;fontSize=15;" parent="pool1" vertex="1">
          <mxGeometry x="820" width="400" height="3320" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="ProjectController.listProjects&lt;br style=&quot;font-size: 15px;&quot;&gt;UserUtils.getUser() 从 SSO 会话取当前 MIS&lt;br style=&quot;font-size: 15px;&quot;&gt;kmSpaceService.getMemberRoles() 成员校验&lt;br style=&quot;font-size: 15px;&quot;&gt;【非成员返回 404 而非 403：&lt;br style=&quot;font-size: 15px;&quot;&gt;不暴露该空间下资源的存在性】" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="250" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="KM 分类树查询接口&lt;br style=&quot;font-size: 15px;&quot;&gt;（权限口径：空间成员）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="850" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="ProjectController.createProject&lt;br style=&quot;font-size: 15px;&quot;&gt;UserUtils 取当前 MIS&lt;br style=&quot;font-size: 15px;&quot;&gt;kmSpaceService.getMemberRoles() 成员校验&lt;br style=&quot;font-size: 15px;&quot;&gt;【权限口径】创建仅要求空间成员&lt;br style=&quot;font-size: 15px;&quot;&gt;（更新/删除才要求创建者或 admin）&lt;br style=&quot;font-size: 15px;&quot;&gt;非成员 → 403" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="1900" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="ProjectService.createProject @Transactional&lt;br style=&quot;font-size: 15px;&quot;&gt;【两写一事务：项目 + 欢迎留言】&lt;br style=&quot;font-size: 15px;&quot;&gt;任一失败整体回滚，杜绝半成品" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="2090" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="① 校验空间真实存在&lt;br style=&quot;font-size: 15px;&quot;&gt;② mdpLeafClient.getSnowFlake() 生成雪花 bizId&lt;br style=&quot;font-size: 15px;&quot;&gt;（全局唯一，即前端路由用的 projectId）&lt;br style=&quot;font-size: 15px;&quot;&gt;③ 构建 ProjectDO，creatorMis = 当前用户" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="2230" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="projectCommentService&lt;br style=&quot;font-size: 15px;&quot;&gt;.insertSystemWelcome()&lt;br style=&quot;font-size: 15px;&quot;&gt;bot 欢迎留言写入 dw_project_comment&lt;br style=&quot;font-size: 15px;&quot;&gt;与项目 INSERT 同一事务提交" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="2390" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="ProjectAssetRefService.bindAsset()&lt;br style=&quot;font-size: 15px;&quot;&gt;四连校验，任一不过返回 400：&lt;br style=&quot;font-size: 15px;&quot;&gt;① 项目存在　② 资产（km_entry）存在&lt;br style=&quot;font-size: 15px;&quot;&gt;③ 同空间（禁止跨空间绑定）&lt;br style=&quot;font-size: 15px;&quot;&gt;④ 已发布（记录发布版本快照）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" parent="laneB" vertex="1">
          <mxGeometry x="50" y="2700" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="laneD" value="数据层（MySQL 表）" style="swimlane;startSize=30;horizontal=0;html=1;fillColor=#E1D5E7;align=center;fontSize=15;" parent="pool1" vertex="1">
          <mxGeometry x="1220" width="400" height="3320" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="SELECT dw_project&lt;br style=&quot;font-size: 15px;&quot;&gt;isDeleted=0 软删过滤&lt;br style=&quot;font-size: 15px;&quot;&gt;keyword 模糊 + 分页" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="laneD" vertex="1">
          <mxGeometry x="70" y="550" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="SELECT km_category（预置分类）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="laneD" vertex="1">
          <mxGeometry x="50" y="880" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="SELECT km_entry&lt;br style=&quot;font-size: 15px;&quot;&gt;（该分类下条目列表）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="laneD" vertex="1">
          <mxGeometry x="50" y="1290" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="INSERT dw_project（isDeleted=0）&lt;br style=&quot;font-size: 15px;&quot;&gt;INSERT dw_project_comment&lt;br style=&quot;font-size: 15px;&quot;&gt;（同一事务提交）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="laneD" vertex="1">
          <mxGeometry x="50" y="2420" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="INSERT dw_project_asset_ref&lt;br style=&quot;font-size: 15px;&quot;&gt;记录发布版本快照 assetVersionId&lt;br style=&quot;font-size: 15px;&quot;&gt;（发布新版本后可再 bind 换绑最新）" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="laneD" vertex="1">
          <mxGeometry x="50" y="2730" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="📦 数据模型总览&lt;br style=&quot;font-size: 15px;&quot;&gt;dw_project 主表（雪花 bizId，软删）&lt;br style=&quot;font-size: 15px;&quot;&gt;├ dw_project_comment 留言（随创建同事务）&lt;br style=&quot;font-size: 15px;&quot;&gt;├ dw_project_asset_ref 资产绑定（独立请求）&lt;br style=&quot;font-size: 15px;&quot;&gt;└ workspaceId → km_space&lt;br style=&quot;font-size: 15px;&quot;&gt;　 assetId → km_entry" style="shape=note;whiteSpace=wrap;html=1;align=center;spacing=6;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=15;size=16;" parent="laneD" vertex="1">
          <mxGeometry x="50" y="3100" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="阶段 ①&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;font-size: 15px;&quot;&gt;进入项目列表页&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;路由匹配 + 分页加载" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#F5F5F5;strokeColor=#999999;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="-190" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="阶段 ②&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;font-size: 15px;&quot;&gt;打开新建弹窗&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;拉取预置分类" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fillColor=#F5F5F5;strokeColor=#999999;rounded=1;" parent="1" vertex="1">
