        <mxCell id="f1f1" value="React Router 匹配 /dw/projects&lt;br&gt;→ ProjectListPage（AppLayout 下）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="laneF" vertex="1">
          <mxGeometry x="50" y="360" width="320" height="80" as="geometry" />
